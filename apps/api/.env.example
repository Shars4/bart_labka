# Only needed when running the API directly on your machine (npm run start:dev,
# prisma migrate dev, prisma db seed). Inside Docker the values come from
# docker-compose.yml.
#
#   cp .env.example .env
#
# Development values only. Never reuse them in production.

NODE_ENV=development
PORT=4000

# Database from `docker compose up -d db` (exposed on port 5433).
# Use 127.0.0.1, not "localhost": the port is bound to IPv4 only, and the
# Prisma schema engine does not fall back from IPv6 (::1) on every OS.
DATABASE_URL=postgresql://shelter:shelter_dev_password@127.0.0.1:5433/shelter?schema=public

# Bootstrap administrator account, created or updated by the seed.
ADMIN_EMAIL=admin@utulok.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Správca útulku

# Access tokens. Any random string of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
JWT_EXPIRES_IN_SECONDS=28800

# Rate limit for sensitive public routes (login, adoption requests).
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
