# Only needed when running the web app directly on your machine
# (npm run dev / npm run build). Inside Docker the values come from
# docker-compose.yml.
#
#   cp .env.example .env.local

# Where the web server reaches the REST API.
API_INTERNAL_URL=http://localhost:4000

# Public URL of the website (canonical and Open Graph URLs).
SITE_URL=http://localhost:3000

# Swagger UI as reachable from the browser (footer link).
PUBLIC_API_DOCS_URL=http://localhost:4000/docs
