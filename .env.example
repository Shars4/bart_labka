# Optional overrides for docker-compose.yml.
#
# `docker compose up` works WITHOUT this file: every variable below has a
# development default in docker-compose.yml. To override a value, copy this
# file to `.env` (which is git-ignored) and edit it:
#
#   cp .env.example .env
#
# The defaults are for local development only. Never reuse them in production.
# Avoid "$" in values (docker compose interpolates it) and, in the database
# password, characters that have a meaning in URLs (@ : / ? #).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=shelter
POSTGRES_PASSWORD=shelter_dev_password
POSTGRES_DB=shelter
# Host port for connecting to the DB from your machine (e.g. Prisma Studio).
POSTGRES_HOST_PORT=5433

# --- API ----------------------------------------------------------------------
# Host port of the API: REST under /api, Swagger UI under /docs.
API_HOST_PORT=4000
# Secret for signing access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
JWT_EXPIRES_IN_SECONDS=28800
# Administrator account created (or updated) on every start.
ADMIN_EMAIL=admin@utulok.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Správca útulku
# Requests per client IP and window on login, registration and adoption
# requests (login and resending the verification email also per account).
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
# Demo user account (role USER, email already verified), created or updated
# on every start. Set either value to empty to skip it.
DEMO_USER_EMAIL=jana.novakova@example.com
DEMO_USER_PASSWORD=Pouzivatel123!
# Sender of the emails the API sends.
MAIL_FROM=Útulok Labka <noreply@utulok.local>

# --- Mailpit (development email inbox) -----------------------------------------
# Every email the API sends ends up in Mailpit's web inbox on this port.
MAILPIT_HOST_PORT=8025
# SMTP port on 127.0.0.1, for an API running directly on your machine.
MAILPIT_SMTP_HOST_PORT=1025

# --- Web ----------------------------------------------------------------------
# Host port of the website.
WEB_HOST_PORT=3000
# Public URL of the website, used for canonical and Open Graph URLs. Also a
# build argument: run `docker compose up --build` after changing it.
SITE_URL=http://localhost:3000
# Swagger UI as reachable from the browser (linked in the footer).
PUBLIC_API_DOCS_URL=http://localhost:4000/docs
# Demo mailbox (Mailpit) linked next to the email verification steps.
# Set it empty to hide the link, e.g. with a real SMTP server.
DEMO_MAILBOX_URL=http://localhost:8025
